---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="An instrument"
  description="A browser-based instrument: drag or press keys to play a live-synthesised pentatonic pad, no wrong notes."
>
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1 class="instrument-title">An instrument</h1>
    <p class="instrument-hint">
      Drag the pad, or play <kbd>a s d f g h j k l ;</kbd> with
      <kbd>&uarr;</kbd>/<kbd>&darr;</kbd> for brightness. &#9210; records a
      phrase to play back.
    </p>
    <div class="transport">
      <button id="start" class="start-button" type="button" aria-pressed="false">
        &#9658; Play
      </button>
      <button id="record" class="record-button" type="button" aria-pressed="false">
        &#9210; Record
      </button>
      <button id="playback" class="playback-button" type="button" disabled>
        &#9658; Play recording
      </button>
    </div>
    <div
      id="pad"
      class="pad"
      role="application"
      tabindex="0"
      aria-label="Pitch and volume pad. Drag anywhere, or use A S D F G H J K L semicolon to play notes and Up/Down arrows to change brightness."
    >
      <svg id="stamps" class="pad-stamps" aria-hidden="true">
        <defs>
          <pattern
            id="stamp-stripes"
            width="10"
            height="10"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(45)"
          >
            <rect width="10" height="10" fill="transparent"></rect>
            <rect width="4" height="10" fill="black"></rect>
          </pattern>
        </defs>
      </svg>
      <div id="cursor" class="pad-cursor" aria-hidden="true"></div>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
